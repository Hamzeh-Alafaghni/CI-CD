<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config — tells IIS how to host this ASP.NET Core app.
  The `dotnet publish` step regenerates/updates this automatically,
  but it is committed so the intent is explicit and reviewable.

  Requires the ASP.NET Core Hosting Bundle installed on the server:
  https://dotnet.microsoft.com/download/dotnet/8.0 (Hosting Bundle)
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        hostingModel="inprocess" runs the app inside the IIS worker process (fast).
        stdoutLogEnabled=false by default; flip to true + create a .\logs folder
        to capture startup errors while learning.
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\SimpleWebApp.Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- Overridden per-site in IIS or by the deploy step. -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
